{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Backend",
            "type": "shell",
            "command": "source venv/bin/activate && uvicorn main:app --reload",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "bioledger"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Frontend",
            "type": "shell",
            "command": "source ~/.nvm/nvm.sh && nvm use 20 && npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend/my-project"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "bioledger"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start Project",
            "dependsOn": [
                "Backend",
                "Frontend"
            ],
            "dependsOrder": "parallel"
        }
    ]
}